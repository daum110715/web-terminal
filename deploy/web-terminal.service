[Unit]
Description=Web terminal (127.0.0.1 only; put a TLS reverse proxy in front)
# The shells live in the host; restarting this unit leaves them running.
Wants=web-terminal-host.service
After=network.target web-terminal-host.service

[Service]
Type=simple
# Clone the repo to ~/web-terminal, or change this path.
WorkingDirectory=%h/web-terminal
# Use the absolute path of your Node 24+ binary; systemd's PATH is minimal.
ExecStart=/usr/bin/node server/main.ts
Environment=WEB_TERMINAL_PORT=3120
# Shells inherit this; without a UTF-8 locale they fall back to C.UTF-8.
Environment=LANG=en_US.UTF-8
# After `npm run build`: picks up the new client without ending open shells.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
UMask=0077
# When the kernel kills one runaway program in a shell for memory, keep the
# service and every other shell running. The default stops the whole service.
OOMPolicy=continue

[Install]
WantedBy=default.target
